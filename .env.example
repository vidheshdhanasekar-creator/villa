# Firebase Web App Credentials (from Firebase Console -> Project Settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Single Admin Account Mapping (for username/password login)
# Example: logging in with username "admin" maps to admin@residency.local (or VITE_ADMIN_EMAIL if set)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_EMAIL=
VITE_ADMIN_EMAIL_DOMAIN=residency.local
